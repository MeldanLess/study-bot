# Таймер резервного копирования базы бота.
#
#   sudo cp deploy/study-bot-backup.timer /etc/systemd/system/
#   sudo systemctl enable --now study-bot-backup.timer
#   systemctl list-timers study-bot-backup.timer
#
# Время выбрано не круглое: в 03:00 по UTC ночные задания сходятся, и сервер
# под нагрузкой. Здесь же `RandomizedDelaySec` разводит копирования разных
# установок по времени.

[Unit]
Description=Ежедневная резервная копия базы учебного бота

[Timer]
OnCalendar=*-*-* 03:23:00
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
