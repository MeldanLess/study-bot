# Токен бота от @BotFather. Обязателен.
TELEGRAM_BOT_TOKEN=

# Ключ Anthropic API. Без него суммаризация заметок выключена, а бот честно
# об этом говорит. Ключ не кладут в репозиторий: файл .env в .gitignore.
ANTHROPIC_API_KEY=

# Модель для суммаризации. Проверьте, что модель актуальна: список моделей
# меняется, и бот подставляет это значение как есть.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Часовой пояс: в нём бот понимает «завтра» и показывает сроки.
TIMEZONE=Europe/Moscow

# Как часто бот проверяет, кому пора напомнить.
REMINDER_INTERVAL_SECONDS=60

# Уровень логирования: DEBUG, INFO, WARNING.
LOG_LEVEL=INFO
