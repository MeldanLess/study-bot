# База бота и её служебные файлы. Это данные одного человека: в репозиторий
# им не место, а восстанавливаются они одной командой.
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Секреты: токен бота и ключ API.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Инструменты
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/

# Служебные каталоги CI.
.ci/
